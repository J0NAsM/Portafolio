# Copia este archivo como .env y reemplaza los valores.
PORT=3000
ADMIN_USER=admin
ADMIN_PASSWORD=usa-una-contrasena-larga-y-unica
ERROR_LOG_SALT=reemplaza-por-un-valor-aleatorio-largo
ERROR_LOG_RETENTION_DAYS=30
# Si la aplicación se despliega detrás de un proxy conocido, establece 1; de lo contrario 0.
TRUST_PROXY=0
