# Copia este archivo como .env y reemplaza los valores.
# Solo lo necesita el servidor Node.js opcional (npm start); el sitio estático
# publicado en GitHub Pages no usa ninguna de estas variables.

# --- Obligatorias para el panel privado ---
# Sin usuario y contraseña, /admin/blog y /admin/errores quedan inaccesibles.
ADMIN_USER=admin
ADMIN_PASSWORD=usa-una-contrasena-larga-y-unica
# Sal para anonimizar las direcciones IP en el registro de errores 404.
ERROR_LOG_SALT=reemplaza-por-un-valor-aleatorio-largo

# --- Opcionales (se muestran los valores por defecto) ---
PORT=3000
# Directorio persistente donde se guardan data/404-errors.json y los respaldos
# del blog. Por defecto es la raíz del proyecto.
STORAGE_ROOT=.
ERROR_LOG_RETENTION_DAYS=30
# Límite de registros locales para evitar crecimiento indefinido (100 a 50000).
ERROR_LOG_MAX_RECORDS=5000
# Si la aplicación se despliega detrás de un proxy conocido, establece 1; de lo contrario 0.
TRUST_PROXY=0
